<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device transfer (API 31+). The manual export file is the reliable path. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="vocab.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="vocab.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
